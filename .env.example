NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Only disabled is supported in production until a provider-specific adapter is approved and sandbox-tested.
# sandbox is strictly non-production and is never a real payment method.
PAYMENT_PROVIDER=disabled
PAYMENT_WEBHOOK_SECRET=
WEB_TEMIFY_ARTIFACT_BUCKET=products-private
TINLANCE_AGENT_SYSTEM_ENABLED=false
TINLANCE_AGENT_SYSTEM_BASE_URL=
TINLANCE_AGENT_SYSTEM_TOKEN=
# Private ClamAV gateway. If unset, evidence uploads stay pending and cannot be linked or posted.
# Local development may use http://127.0.0.1:8088/v1/scan; production must use HTTPS.
CLAMAV_SCANNER_URL=
CLAMAV_SCANNER_TOKEN=
LOG_LEVEL=info

# Dedicated GitHub Actions worker credentials. Use different random secrets (at least 32 characters).
# Do not reuse CRON_SECRET or the other worker's token.
SUPPORT_NOTIFICATION_WORKER_TOKEN=
PAYMENT_DISPUTE_ALERT_WORKER_TOKEN=

# Resend outbound mail configuration. Sender/domain verification is a production prerequisite.
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=
SUPPORT_OPERATIONS_EMAIL=
DISPUTE_OPERATIONS_EMAIL=

# Protected Vercel Cron worker for expired, unlinked settlement evidence.
# CRON_SECRET is not accepted by the support-notification or dispute-deadline workers.
CRON_SECRET=
SETTLEMENT_EVIDENCE_RETENTION_TOKEN=
